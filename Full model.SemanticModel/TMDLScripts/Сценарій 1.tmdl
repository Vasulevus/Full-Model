		partition Календар = calculated
			mode: import
			source =
					
					VAR __startdate = DATE(2025, 1, 1)
					VAR __enddate = DATE(2026, 12, 31)
					VAR __calendar = CALENDAR(__startdate, __enddate)
					VAR __calendar_with_details =
					    ADDCOLUMNS(
					        __calendar,
					        "Рік", YEAR([Date]),
					        "Квартал", QUARTER([Date]),
					        "Місяць", MONTH([Date]),
					        "День", DAY([Date])
					    )
					RETURN
					    __calendar_with_details

