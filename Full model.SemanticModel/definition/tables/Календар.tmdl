	column 'День тижня'
		formatString: 0
		lineageTag: a1fd6118-3080-4b78-a1b5-0de769e4da4f
		summarizeBy: none
		isNameInferred
		sourceColumn: [День тижня]

		annotation SummarizationSetBy = Automatic

	partition Календар = calculated
		mode: import
		source =
				
				VAR __startdate = DATE(2025, 1, 1)
				VAR __enddate = DATE(2026, 12, 31)
				VAR __calendar = CALENDAR(__startdate, __enddate)
				VAR __calendar_with_details =
				    ADDCOLUMNS(
				        __calendar,
				        "Рік", YEAR([Date]),
				        "Квартал", QUARTER([Date]),
				        "Місяць", MONTH([Date]),
				        "День", DAY([Date])
				        ,"День тижня", WEEKDAY([Date],2)
				    )
				RETURN
				    __calendar_with_details

	annotation PBI_Id = 7d3e7873faed4e33b3f2ef1491f24127

