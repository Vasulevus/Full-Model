	partition Таблиця = calculated
		mode: import
		source = ```
				
				VAR Products =
				    DATATABLE (
				        "Товар", STRING,
				        {
				            { "Велосипед" },
				            { "Самокат" },
				            { "Ролики" },
				            { "Скейт" }
				        }
				    )
				RETURN
				    ADDCOLUMNS (
				        FILTER (
				            CROSSJOIN (
				                Products,
				                GENERATESERIES ( 1, 10, 1 )
				            ),
				            [Value] <= ROUNDUP ( RAND() * 5, 0 )
				        ),
				        "Кількість", [Value]
				    )
				
				```

	annotation PBI_Id = 68dab07f1eee403295d9b0f186796a02

